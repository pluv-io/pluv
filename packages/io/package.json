{
    "name": "@pluv/io",
    "version": "5.0.2",
    "description": "@pluv/io server-side websocket manager",
    "author": {
        "email": "david@pluv.io",
        "name": "i3dly",
        "url": "https://github.com/i3dly"
    },
    "license": "MIT",
    "homepage": "https://github.com/pluv-io/pluv",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pluv-io/pluv.git",
        "directory": "packages/server"
    },
    "type": "module",
    "types": "./dist/index.d.mts",
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "pnpm run version && tsdown",
        "dev": "tsdown --watch",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
        "version": "genversion ./src/version.generated.ts --esm"
    },
    "dependencies": {
        "@panva/hkdf": "^1.2.1",
        "@pluv/crdt": "workspace:^",
        "@pluv/types": "workspace:^",
        "jose": "^6.2.10",
        "kleur": "^4.1.5",
        "wonka": "^6.3.6"
    },
    "devDependencies": {
        "@pluv/tsconfig": "workspace:^",
        "genversion": "^3.2.0",
        "tsdown": "0.22.14",
        "typescript": "^7.0.2"
    },
    "exports": {
        ".": "./dist/index.mjs",
        "./*": "./*"
    }
}
