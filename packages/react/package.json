{
	"name": "@pluv/react",
	"version": "5.0.2",
	"description": "@pluv/client React.js bindings",
	"author": {
		"email": "david@pluv.io",
		"name": "i3dly",
		"url": "https://github.com/i3dly"
	},
	"license": "MIT",
	"homepage": "https://github.com/pluv-io/pluv",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pluv-io/pluv.git",
		"directory": "packages/react"
	},
	"type": "module",
	"types": "./dist/index.d.mts",
	"files": ["dist"],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"lint": "prettier --check \"src/**/*.{ts,tsx}\" --ignore-path ../../.prettierignore",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
	},
	"dependencies": {
		"@pluv/client": "workspace:^",
		"@pluv/crdt": "workspace:^",
		"@pluv/types": "workspace:^",
		"fast-deep-equal": "^3.1.3"
	},
	"peerDependencies": {
		"@types/react": "^18.0.0 || ^19.0.0",
		"react": "^18.0.0 || ^19.0.0"
	},
	"devDependencies": {
		"@pluv/tsconfig": "workspace:^",
		"@types/react": "^19.2.18",
		"eslint": "^10.9.0",
		"eslint-config-pluv": "workspace:^",
		"react": "^19.2.8",
		"tsdown": "0.22.14",
		"typescript": "^7.0.2"
	},
	"exports": {
		".": "./dist/index.mjs",
		"./*": "./*"
	}
}
