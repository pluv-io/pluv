{
    "name": "@pluv-tests/e2e",
    "version": "0.0.0",
    "sideEffects": false,
    "private": true,
    "type": "module",
    "scripts": {
        "cf:typegen": "wrangler types --env-interface CloudflareEnv ./cf.d.ts",
        "dev": "concurrently \"pnpm:dev:client\" \"pnpm:dev:noop:server:node\" \"pnpm:dev:yjs:server:cloudflare\" \"pnpm:dev:yjs:server:node\" \"pnpm:dev:yjs:server:node-redis\" \"pnpm:dev:yjs:server:platform\"",
        "dev:client": "next dev --port 3100 --webpack",
        "dev:loro:server:node": "vite-node --config ./vite.server.config.ts ./src/server/loro/node/index.ts -- --port 3112",
        "dev:noop:server:node": "vite-node --config ./vite.server.config.ts ./src/server/noop/node/index.ts -- --port 3122",
        "dev:yjs:server:cloudflare": "wrangler dev --port 3101",
        "dev:yjs:server:node": "vite-node --config ./vite.server.config.ts ./src/server/yjs/node/index.ts -- --port 3102",
        "dev:yjs:server:node-redis": "vite-node --config ./vite.server.config.ts ./src/server/yjs/node-redis/index.ts -- --port 3103",
        "dev:yjs:server:platform": "node ./scripts/bundle-platform-room.mjs && wrangler dev --config wrangler.platform.jsonc --port 3104",
        "db:push": "drizzle-kit push",
        "db:push:neon": "drizzle-kit push --config drizzle.neon.config.ts",
        "playwright": "playwright",
        "start": "next start",
        "test": "playwright test",
        "test:noop:node": "playwright test ./src/tests/noop/node/**/*",
        "test:loro:node": "playwright test ./src/tests/loro/node/**/*",
        "test:yjs:cloudflare-sqlite": "wrangler deploy --dry-run && playwright test ./src/tests/yjs/cloudflare-sqlite/**/*",
        "test:yjs:node": "rm -f dev.db && drizzle-kit push && playwright test ./src/tests/yjs/node/**/*",
        "test:yjs:node-redis": "playwright test ./src/tests/yjs/node-redis/**/*",
        "test:yjs:platform": "playwright test ./src/tests/yjs/platform/**/*",
        "typecheck": "pnpm cf:typegen && tsc --noEmit"
    },
    "dependencies": {
        "@blocknote/core": "^0.56.0",
        "@blocknote/mantine": "^0.56.0",
        "@blocknote/react": "^0.56.0",
        "@hono/node-server": "^2.1.5",
        "@lexical/react": "^0.52.0",
        "@lexical/utils": "^0.52.0",
        "@lexical/yjs": "^0.52.0",
        "@neondatabase/serverless": "^1.2.0",
        "@pluv/addon-indexeddb": "workspace:^",
        "@pluv/client": "workspace:^",
        "@pluv/crdt": "workspace:^",
        "@pluv/crdt-loro": "workspace:^",
        "@pluv/crdt-yjs": "workspace:^",
        "@pluv/io": "workspace:^",
        "@pluv/persistence-cloudflare-transactional-storage": "workspace:^",
        "@pluv/persistence-redis": "workspace:^",
        "@pluv/platform": "workspace:^",
        "@pluv/platform-cloudflare": "workspace:^",
        "@pluv/platform-node": "workspace:^",
        "@pluv/platform-pluv": "workspace:^",
        "@pluv/react": "workspace:^",
        "@pluv/treaty": "workspace:^",
        "@pluv/types": "workspace:^",
        "@slate-yjs/core": "^1.0.2",
        "@types/better-sqlite3": "^9.6.0",
        "@types/common-tags": "^1.8.4",
        "@types/cors": "^2.8.19",
        "@types/ms": "^2.1.0",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/ws": "^8.18.2",
        "better-sqlite3": "^13.0.3",
        "commander": "^15.0.0",
        "common-tags": "^1.8.2",
        "drizzle-orm": "^0.45.4",
        "hono": "^4.13.14",
        "ioredis": "^6.0.0",
        "lexical": "^0.52.0",
        "loro-crdt": "^1.17.1",
        "ms": "^2.1.3",
        "next": "^16.4.3",
        "path-to-regexp": "^9.0.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "slate": "^0.146.0",
        "slate-dom": "^0.147.3",
        "slate-react": "^0.147.3",
        "ws": "^8.22.0",
        "y-prosemirror": "^1.3.7",
        "yjs": "^13.6.33",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20261025.1",
        "@playwright/test": "^1.64.1",
        "@pluv/tsconfig": "workspace:^",
        "concurrently": "^10.0.6",
        "drizzle-kit": "^0.31.11",
        "esbuild": "^0.28.2",
        "miniflare": "^4.20260730.0",
        "typescript": "7.1.0-beta",
        "vite": "^8.3.5",
        "vite-node": "^6.0.0",
        "wrangler": "^4.152.0"
    }
}
