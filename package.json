{
  "name": "pluv-monorepo",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af",
  "scripts": {
    "build": "turbo run build",
    "build:internal": "turbo run build --filter=./internal/*",
    "build:packages": "turbo run build --filter=./packages/*",
    "changeset": "changeset",
    "clean": "turbo run clean && rm -rf node_modules",
    "commit": "cz",
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --parallel --filter=./apps/*",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "release": "turbo run build --filter=./packages/* && changeset publish",
    "services:start": "docker compose up -d",
    "services:stop": "docker compose down",
    "test": "turbo run test",
    "test:e2e": "turbo run test --filter=@pluv-tests/e2e...",
    "test:types": "turbo run test --filter=@pluv-tests/types...",
    "typecheck": "turbo run typecheck",
    "turbo": "turbo",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11"
  }
}
