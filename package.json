{
  "name": "pluv-monorepo",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "scripts": {
    "build": "turbo run build",
    "build:internal": "turbo run build --filter=./internal/*",
    "build:packages": "turbo run build --filter=./packages/*",
    "changeset": "changeset",
    "clean": "turbo run clean && rm -rf node_modules",
    "commit": "cz",
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --parallel --filter=./apps/*",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "release": "turbo run build --filter=./packages/* && changeset publish",
    "services:start": "docker compose up -d",
    "services:stop": "docker compose down",
    "test": "turbo run test",
    "test:e2e": "turbo run test --filter=@pluv-tests/e2e...",
    "test:types": "turbo run test --filter=@pluv-tests/types...",
    "typecheck": "turbo run typecheck",
    "turbo": "turbo",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11"
  }
}
