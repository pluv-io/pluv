{
    "name": "pluv-monorepo",
    "private": true,
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
    "scripts": {
        "build": "turbo run build",
        "build:internal": "turbo run build --filter=./internal/*",
        "build:packages": "turbo run build --filter=./packages/*",
        "changeset": "changeset",
        "clean": "turbo run clean && rm -rf node_modules",
        "commit": "cz",
        "dev": "turbo run dev --parallel",
        "dev:web": "turbo run dev --parallel --filter=./apps/*",
        "format": "oxfmt",
        "lint": "oxlint --type-aware && oxfmt --check .",
        "lint:fix": "oxlint --fix --type-aware && oxfmt",
        "release": "turbo run build --filter=./packages/* && changeset publish",
        "services:start": "docker compose up -d",
        "services:stop": "docker compose down",
        "test": "turbo run test",
        "test:e2e": "turbo run test --filter=@pluv-tests/e2e...",
        "test:types": "turbo run test --filter=@pluv-tests/types...",
        "test:unit": "turbo run test --filter=@pluv-tests/unit...",
        "typecheck": "turbo run typecheck",
        "turbo": "turbo",
        "version-packages": "changeset version"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.3",
        "commitizen": "^4.3.2",
        "cz-conventional-changelog": "^3.3.0",
        "eslint-plugin-turbo": "^2.11.10",
        "oxfmt": "^0.77.0",
        "oxlint": "^1.92.0",
        "oxlint-tsgolint": "^7.0.2006",
        "turbo": "^2.11.10"
    }
}
