{
    "name": "pluv-monorepo",
    "private": true,
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
    "scripts": {
        "build": "turbo run build",
        "build:internal": "turbo run build --filter=./internal/*",
        "build:packages": "turbo run build --filter=./packages/*",
        "changeset": "changeset",
        "clean": "turbo run clean && rm -rf node_modules",
        "commit": "cz",
        "dev": "turbo run dev --parallel",
        "dev:web": "turbo run dev --parallel --filter=./apps/*",
        "format": "oxfmt",
        "lint": "oxlint --type-aware && oxfmt --check .",
        "lint:fix": "oxlint --fix --type-aware && oxfmt",
        "release": "turbo run build --filter=./packages/* && changeset publish",
        "services:start": "docker compose up -d",
        "services:stop": "docker compose down",
        "test": "turbo run test",
        "test:e2e": "turbo run test --filter=@pluv-tests/e2e...",
        "test:types": "turbo run test --filter=@pluv-tests/types...",
        "test:unit": "turbo run test --filter=@pluv-tests/unit...",
        "typecheck": "turbo run typecheck",
        "turbo": "turbo",
        "version-packages": "changeset version"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.3",
        "commitizen": "^4.3.2",
        "cz-conventional-changelog": "^3.3.0",
        "eslint-plugin-turbo": "^2.11.7",
        "oxfmt": "^0.72.0",
        "oxlint": "^1.87.0",
        "oxlint-tsgolint": "^7.0.2003",
        "turbo": "^2.11.7"
    }
}
