{
    "name": "pluv-monorepo",
    "private": true,
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
    "scripts": {
        "build": "turbo run build",
        "build:internal": "turbo run build --filter=./internal/*",
        "build:packages": "turbo run build --filter=./packages/*",
        "changeset": "changeset",
        "clean": "turbo run clean && rm -rf node_modules",
        "commit": "cz",
        "dev": "turbo run dev --parallel",
        "dev:web": "turbo run dev --parallel --filter=./apps/*",
        "format": "oxfmt",
        "lint": "oxlint --type-aware && oxfmt --check .",
        "lint:fix": "oxlint --fix --type-aware && oxfmt",
        "release": "turbo run build --filter=./packages/* && changeset publish",
        "services:start": "docker compose up -d",
        "services:stop": "docker compose down",
        "test": "turbo run test",
        "test:e2e": "turbo run test --filter=@pluv-tests/e2e...",
        "test:types": "turbo run test --filter=@pluv-tests/types...",
        "test:unit": "turbo run test --filter=@pluv-tests/unit...",
        "typecheck": "turbo run typecheck",
        "turbo": "turbo",
        "version-packages": "changeset version"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.3",
        "commitizen": "^4.3.2",
        "cz-conventional-changelog": "^3.3.0",
        "eslint-plugin-turbo": "^2.11.2",
        "oxfmt": "^0.70.0",
        "oxlint": "^1.83.0",
        "oxlint-tsgolint": "^7.0.2002",
        "turbo": "^2.11.2"
    }
}
