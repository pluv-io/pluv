{
    "extends": "@pluv/tsconfig/frontend-generic.json",
    "include": ["**/*.ts", "**/*.tsx"],
    "exclude": ["node_modules", ".output", "dist"],
    "compilerOptions": {
        "declaration": false,
        "declarationMap": false,
        "jsx": "react-jsx",
        "lib": ["DOM", "DOM.Iterable", "ES2022"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ES2022",
        "types": ["vite/client"],
        "paths": {
            "@/*": ["./src/*"]
        }
    }
}
