{
    "name": "@repo/docs",
    "version": "0.0.0",
    "sideEffects": false,
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:staging": "CLOUDFLARE_ENV=staging vite build",
        "dev": "vite dev",
        "typecheck": "fumadocs-mdx && pnpm cf:typegen && tsc --noEmit",
        "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf .output && rm -rf dist && rm -rf .source && rm -f cf.d.ts",
        "cf:typegen": "wrangler types ./cf.d.ts",
        "deploy": "pnpm run deploy:prod",
        "deploy:prod": "pnpm build && wrangler deploy",
        "deploy:staging": "pnpm run build:staging && wrangler deploy --env staging",
        "preview": "vite preview"
    },
    "dependencies": {
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@tanstack/react-router": "^1.170.45",
        "@tanstack/react-router-devtools": "^1.167.2",
        "@tanstack/react-start": "^1.169.3",
        "beautiful-mermaid": "^1.1.3",
        "fumadocs-core": "^16.17.5",
        "fumadocs-mdx": "^15.4.7",
        "fumadocs-ui": "^16.17.5",
        "lucide-react": "^1.59.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "shadcn": "^4.22.1",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.64.0",
        "@cloudflare/workers-types": "^5.20261018.1",
        "@pluv/tsconfig": "workspace:^",
        "@tailwindcss/vite": "^4.3.3",
        "@types/mdx": "^2.0.14",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.4",
        "wrangler": "^4.151.1"
    }
}
