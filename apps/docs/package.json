{
    "name": "@repo/docs",
    "version": "0.0.0",
    "sideEffects": false,
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite dev",
        "typecheck": "fumadocs-mdx && pnpm cf:typegen && tsc --noEmit",
        "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf .output && rm -rf dist && rm -rf .source && rm -f cf.d.ts",
        "cf:typegen": "wrangler types ./cf.d.ts",
        "deploy": "pnpm build && wrangler deploy",
        "preview": "vite preview"
    },
    "dependencies": {
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@tanstack/react-router": "^1.170.41",
        "@tanstack/react-router-devtools": "^1.167.2",
        "@tanstack/react-start": "^1.168.60",
        "fumadocs-core": "^16.16.2",
        "fumadocs-mdx": "^15.4.6",
        "fumadocs-ui": "^16.16.2",
        "lucide-react": "^1.52.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "shadcn": "^4.21.3",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.62.5",
        "@cloudflare/workers-types": "^5.20261006.1",
        "@pluv/tsconfig": "workspace:^",
        "@tailwindcss/vite": "^4.3.3",
        "@types/mdx": "^2.0.14",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.3",
        "wrangler": "^4.147.0"
    }
}
